# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REASONING_MODEL=openai/gpt-4o-mini

# HuggingFace Embeddings Configuration
HF_TOKEN=your-huggingface-token-here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tavily API Configuration (CRAG Fallback Search)
TAVILY_API_KEY=your-tavily-api-key-here

# SQLite Log Storage Configuration
SQLITE_DB_PATH=mcp_agent_log.db

# Resilience & Fault Tolerance Settings
MAX_RETRY_ATTEMPTS=3

# Neo4j Property Graph Configuration (Aura DB or Local Instance)
NEO4J_URI=neo4j+s://your-neo4j-uri-here
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# MCP Host & Network Configuration
MCP_HOST=0.0.0.0
MCP_PORT=8000
